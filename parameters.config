limit=100 # Limit per stocks to return per group
group="52-week-gainers" #DAY_GAINERS, DAY_LOSERS, MOST_ACTIVES, FIFTY_TWO_WK_GAINERS, FIFTY_TWO_WK_LOSERS UNUSUAL_VOLUME, MOST_SHORTED_STOCKS, TOP_VOLUME_ETFS
max_liquid=100000
min_liquid=0
dry=true

# Trading strategy parameters
profit_target=0.0012       # 0.12% gain target before selling
stop_loss_pct=0.005        # 0.5% drop from buy price triggers stop-loss sell
max_hold_minutes=30        # Max minutes to hold a batch before force-selling
batch_size=4               # Number of stocks to buy per cycle
quantity=2                 # Number of shares to buy per stock